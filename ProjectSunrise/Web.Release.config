<?xml version="1.0"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="DefaultConnection"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=ProjectSunrise;Integrated Security=True;MultipleActiveResultSets=True"
         xdt:Locator="Match(name)" xdt:Transform="SetAttributes(connectionString)" />
  </connectionStrings>
  <entityFramework>
    <contexts xdt:Transform="Insert">
      <context type="ProjectSunrise.ApplicationDbContext, ProjectSunrise" disableDatabaseInitialization="true" />
    </contexts>
  </entityFramework>
  <system.web>
    <customErrors mode="On" xdt:Transform="Insert" />
    <compilation xdt:Transform="RemoveAttributes(debug)" />
  </system.web>
</configuration>
